# Opt in to host role aliases AFTER installing/verifying robot-specific rules.
# Merge these lines into deploy/.env; do not overwrite an existing .env.
# Without these overrides, Compose keeps its legacy host-device defaults.
# SERIAL_DEV remains a deprecated fallback; non-empty CHASSIS_DEV wins.
CHASSIS_DEV=/dev/op-chassis
GNSS_DEV=/dev/op-gnss
IMU_DEV=/dev/op-imu
LIDAR_DEV=/dev/op-lidar

# SERIAL_BAUD=115200
# NTRIP_PARAMS=/data/ntrip.yaml
# DATA_DIR=/absolute/path/to/persistent/deploy/data

# Select installed/mounted profiles and native ROS parameter files.
# Paths below are INSIDE the container; deploy/data is mounted at /data.
# GNSS_LAUNCH_FILE=/data/profiles/gnss_replacement.launch.py
# IMU_LAUNCH_FILE=/data/profiles/imu_replacement.launch.py
# LIDAR_LAUNCH_FILE=/data/profiles/lidar_replacement.launch.py
# GNSS_PARAMS=/data/config/gnss.yaml
# IMU_PARAMS=/data/config/imu.yaml
# LIDAR_PARAMS=/data/config/lidar.yaml

# Usually leave *_PORT unset: the driver receives /dev/op-<role>.
# To use a non-serial profile, remove its USB binding with a Compose override
# AND set its *_PORT explicitly empty (not *_DEV). Example for network lidar:
# LIDAR_PORT=
