<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>outdoor_patrol_route</name>
  <version>0.0.1</version>
  <description>
    GNSS teach-and-repeat route recording and following. `route_recorder`
    turns one manually driven pass into a geodetic route file; `route_follower`
    repeats it with pure pursuit, displacing the look-ahead point sideways onto
    the shoulder to get around obstacles. See doc/eng/plans/
    issue-8-teach-and-repeat.md.
  </description>
  <maintainer email="dev@example.com">Outdoor Patrol Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- toLL / fromLL live on navsat_transform_node. -->
  <exec_depend>robot_localization</exec_depend>
  <!-- The whole GNSS chain the recorder and follower sit on top of. -->
  <exec_depend>outdoor_patrol_loc</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
