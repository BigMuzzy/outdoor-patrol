# One-screen field validation layout.
#
#   ros2 launch outdoor_patrol_validation field_dashboard.launch.py
#
# The 3D view carries the geometry, the docked FieldDashboard panel carries
# every number and gate from doc/eng/plans/field-validation-alley.md. Between
# them there is nothing left to check in a second terminal, which is the whole
# point: outdoors, next to a moving robot, alt-tabbing is how a phase gets
# recorded wrong.
#
# In the 3D view:
#
#   green line      the recorded centerline being followed
#   white lines     lane edges
#   orange lines    corridor edges -- the follower will not steer outside these
#   orange sphere   the live look-ahead point. Watch it swing RIGHT as the
#                   obstacle comes up in Phase 6; that displacement IS d_cmd.
#   yellow points   /scan. In an alley, the two parallel walls.
#   orange arrows   the global EKF estimate
#
# In the panel:
#
#   top tiles       live sigma, fix quality, heading, follower state,
#                   cross-track, d_cmd and clearance. Colour is the judgement:
#                   green in spec, amber marginal, red out, grey stale.
#   phase list      Phase 0-7 with their running verdict. Select one to see
#                   its gates; the running phase is marked with an arrow.
#   gate table      every check for the selected phase, live. Red rows carry
#                   the fix in the box underneath.
#   buttons         Start/Stop the selected phase, Mark pass/fail for the ones
#                   no sensor can settle, Reset to re-run, Write report.
#
# If the panel says NO DASHBOARD NODE, the gates are not being accumulated:
#   ros2 run outdoor_patrol_validation field_dashboard
#
# A satellite basemap is deliberately NOT in here -- it needs connectivity you
# may not have on site. Use outdoor_patrol_bringup's gnss.rviz for that.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 200
  - Class: outdoor_patrol_validation/FieldDashboardPanel
    Name: FieldDashboard
    StateTopic: /field_dashboard/state
    CommandTopic: /field_dashboard/command
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 60
      Color: 90; 90; 90
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    # Centerline, lane edges, corridor edges and the live look-ahead point.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: RouteCorridor
      Topic:
        Value: /route_follower/markers
        Depth: 20
        Durability Policy: Volatile
        Reliability Policy: Reliable
    # The alley walls, and in Phase 6 the obstacle. Big points: at 30 m the
    # default 3 px is hard to see on a laptop in daylight.
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Scan
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 5
      Color: 255; 255; 0
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: GlobalEKF
      Topic:
        Value: /odometry/global
        Depth: 20
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 100
      Position Tolerance: 0.5
      Angle Tolerance: 0.2
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 255; 140; 0
        Alpha: 0.8
        Shaft Length: 0.35
        Shaft Radius: 0.04
        Head Length: 0.12
        Head Radius: 0.09
    # Ground truth, sim only -- absent outdoors and harmless when it is.
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: GroundTruth
      Topic:
        Value: /odom_truth
        Depth: 20
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 100
      Position Tolerance: 0.5
      Angle Tolerance: 0.2
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 60; 220; 90
        Alpha: 0.8
        Shaft Length: 0.35
        Shaft Radius: 0.04
        Head Length: 0.12
        Head Radius: 0.09
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      # Locked to base_link so the robot stays centred for the whole 30 m
      # run. A static overview loses it within seconds, and re-framing the
      # camera by hand while a robot is moving is exactly the distraction
      # this layout exists to remove.
      Class: rviz_default_plugins/Orbit
      Target Frame: base_link
      Distance: 18.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Follow robot
      Pitch: 1.1
      Yaw: 1.57
    Saved:
      - Class: rviz_default_plugins/Orbit
        Target Frame: <Fixed Frame>
        Distance: 40.0
        Focal Point:
          X: 15
          Y: 0
          Z: 0
        Name: Whole alley
        Pitch: 1.3
        Yaw: 1.57
      - Class: rviz_default_plugins/Orbit
        Target Frame: base_link
        Distance: 8.0
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Name: Close follow
        Pitch: 0.6
        Yaw: 1.57
      - Class: rviz_default_plugins/TopDownOrtho
        Scale: 20
        Name: Top down
        X: 0
        Y: 0
Window Geometry:
  Height: 1000
  Width: 1720
  Displays:
    collapsed: false
  FieldDashboard:
    collapsed: false
