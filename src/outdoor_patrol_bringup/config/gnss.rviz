Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    # Global (map-frame) EKF — covariance on, to watch the gate inflate it.
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: OdometryGlobal
      Topic:
        Value: /odometry/global
        Depth: 100
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Covariance:
        Value: true
        Position:
          Color: 0; 255; 0
          Alpha: 0.3
      Keep: 1000
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Color: 0; 255; 0
        Alpha: 1.0
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
    # Local (odom-frame) EKF — the smooth dead-reckoned pose.
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: OdometryFiltered
      Topic:
        Value: /odometry/filtered
        Depth: 100
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Covariance:
        Value: false
      Keep: 1000
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Color: 255; 85; 0
        Alpha: 0.8
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
    # Raw GNSS-as-odometry from navsat_transform (off by default).
    - Class: rviz_default_plugins/Odometry
      Enabled: false
      Name: OdometryGps
      Topic:
        Value: /odometry/gps
        Depth: 100
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Covariance:
        Value: true
      Keep: 200
      Position Tolerance: 0.02
      Angle Tolerance: 0.05
      Shape:
        Value: Axes
        Alpha: 1.0
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.6
      Yaw: 0.785
Window Geometry:
  Height: 800
  Width: 1200
