<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="outdoor_patrol">

  <!--
    Diff-drive URDF. Geometry and module mount poses are read from
    config/chassis.yaml (single source of truth) — adjust dimensions and
    sensor placements THERE, not in this file.

    Frames follow REP-105: base_link (chassis) is the estimated body frame
    (the EKFs publish odom -> base_link, matching the wheel-odom child frame),
    with base_footprint as its ground projection hung below it, and module
    frames (gnss_link, …) hung off base_link from the yaml `modules:` section.

    Wheel joints are FIXED until a joint-state source exists (M1+ switches
    them to 'continuous' when odometry / ros2_control feeds joint_states).
  -->

  <!-- ── Config: single source of truth (config/chassis.yaml) ─────── -->
  <xacro:property name="cfg"
      value="${xacro.load_yaml('$(find outdoor_patrol_bringup)/config/chassis.yaml')}"/>
  <xacro:property name="ch" value="${cfg['chassis']}"/>

  <xacro:property name="wheel_radius"     value="${ch['wheel_radius']}"/>
  <xacro:property name="wheel_separation" value="${ch['wheel_separation']}"/>
  <xacro:property name="base_height"      value="${ch['base_height']}"/>
  <xacro:property name="wheel_width"      value="${ch['wheel_width']}"/>
  <xacro:property name="body_length"      value="${ch['body_length']}"/>
  <xacro:property name="body_width"       value="${ch['body_width']}"/>
  <xacro:property name="body_height"      value="${ch['body_height']}"/>
  <xacro:property name="body_offset_x"    value="${ch['body_offset_x']}"/>

  <!-- base_footprint sits on the ground directly below base_link. -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="${body_offset_x} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.4 0.4 0.45 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_link_to_base_footprint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_footprint"/>
    <origin xyz="0 0 ${-base_height}" rpy="0 0 0"/>
  </joint>

  <!-- ── Wheels ───────────────────────────────────────────────────── -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_offset} ${-base_height + wheel_radius}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_offset="${ wheel_separation/2}"/>
  <xacro:wheel prefix="right" y_offset="${-wheel_separation/2}"/>

  <!-- ── Module mount frames (from config/chassis.yaml `modules:`) ─── -->
  <!-- Each becomes <link> + fixed <joint> at the yaml-supplied pose.
       Add a sensor = add a `modules:` entry + one module_frame call. -->
  <xacro:macro name="module_frame" params="name parent xyz rpy">
    <link name="${name}"/>
    <joint name="${parent}_to_${name}" type="fixed">
      <parent link="${parent}"/>
      <child  link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:property name="modules" value="${cfg['modules']}"/>

  <xacro:property name="gnss" value="${modules['gnss_link']}"/>
  <xacro:module_frame name="gnss_link" parent="${gnss['parent']}"
                      xyz="${gnss['xyz']}" rpy="${gnss['rpy']}"/>

</robot>
