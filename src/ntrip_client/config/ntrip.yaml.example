# Example NTRIP caster configuration. Copy to ntrip.yaml and fill in
# credentials; ntrip.yaml is gitignored.
ntrip_client:
  ros__parameters:
    host: ""                       # e.g. rtk2go.com
    port: 2101
    mountpoint: ""                 # e.g. MyMount
    username: ""
    password: ""
    ntrip_version: auto            # 1 | 2 | auto
    user_agent: "ntrip_client/0.0.1 ROS2"
    send_gga: true
    # VRS casters need the client position to start streaming. The first GGA is
    # uploaded immediately on connect; this is the period between subsequent
    # uploads. Keep ~10s for VRS (a very short period makes some casters
    # re-anchor the virtual base and never fix). Safe to leave < rtcm_timeout_s.
    gga_period_s: 10.0
    reconnect_backoff_s_min: 1.0
    reconnect_backoff_s_max: 30.0
    # Force a reconnect if no RTCM arrives for this many seconds while the
    # socket is still open (stalled / half-open VRS). 0 disables.
    rtcm_timeout_s: 5.0
    # Bound each TCP connect attempt so a dead network fails fast. 0 = OS default.
    connect_timeout_s: 5.0
    frame_id: gnss_link
