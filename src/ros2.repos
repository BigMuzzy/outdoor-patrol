# List of repositories to use within your workspace
# See https://github.com/dirk-thomas/vcstool
############ 
# Example:
############
repositories:
  examples:
    type: git
    url: https://github.com/ros2/examples.git
    version: ${ROS_DISTRO}
  robot-research:
    type: git
    url: git@github.com:BigMuzzy/robot-research.git
    version: main
  esp32-s3-uros-controller:
    type: git
    url: git@github.com:BigMuzzy/esp32-s3-uros-controller.git
    version: main
  sllidar_ros2:
    type: git
    url: https://github.com/Slamtec/sllidar_ros2.git
    version: main
