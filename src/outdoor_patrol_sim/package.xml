<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>outdoor_patrol_sim</name>
  <version>0.0.1</version>
  <description>
    Gazebo (gz-sim / Harmonic) simulation of the outdoor patrol robot. Wraps
    the outdoor_patrol_bringup URDF with physics, a diff-drive plugin and
    simulated LiDAR / IMU / GNSS, bridged onto the SAME ROS topic names the
    real hardware drivers publish so the localization stack runs unchanged.
  </description>
  <maintainer email="dev@example.com">Outdoor Patrol Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- Geometry + chassis.yaml single source of truth, and the EKF stack. -->
  <exec_depend>outdoor_patrol_bringup</exec_depend>
  <exec_depend>outdoor_patrol_loc</exec_depend>

  <!-- Gazebo Harmonic via the ros_gz vendor packages (jazzy). -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
