// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"dockerFile": "Dockerfile",
	"build": {
		"args": {
			"ROS_DISTRO": "jazzy",
			"ROS_VARIANT": "full"
		},
		"options": ["--pull"]
	},
	// Runs on the HOST before the container is created. Installs the udev
	// rule that creates the stable /dev/esp32-chassis symlink so the
	// --device passthrough below works (udev/dev are host-managed; this
	// cannot be done in the Dockerfile). Idempotent; may prompt for sudo.
	"initializeCommand": "${localWorkspaceFolder}/.devcontainer/install-udev-rules.sh",
	"runArgs": [
		"--network=host",
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined",
		// X11 host
		"--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
		// Wayland host
		"--volume=/mnt/wslg:/mnt/wslg",
		"--ipc=host",
		// uncomment to use intel iGPU
		// "--device=/dev/dri"
		// Share user run time settings
		"--volume=/run/user/1000:/run/user/1000", // Change 1000 to match your UID
		// ── Serial hardware passthrough ──────────────────────────────
		// Give the container user access to serial devices on the host.
		"--group-add=dialout",
		// TEMPORARY (bring-up): map ALL host devices live instead of
		// pinning individual nodes. Docker's `--device` binds a node at
		// container-CREATE time and never tracks USB re-enumeration, so a
		// device reboot (e.g. the ESP32-S3's native USB-Serial/JTAG, which
		// leaves the bus on every chip reset) leaves the in-container node
		// stale -> the agent opens fd:3 but never gets a session (errno 6).
		// Bind-mounting /dev makes nodes appear/disappear live, and
		// --privileged grants the device-cgroup access to use them. This is
		// permissive; tighten back to specific --device entries (or a
		// device-cgroup-rule + /dev mount) once the stack is stable.
		"--privileged",
		"--volume=/dev:/dev",
		// Reference: previously-pinned nodes (re-enable once locked down).
		// "--device=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0", // UM982 GNSS (CH340)
		// "--device=/dev/serial/by-id/usb-FTDI_FT230X_Basic_UART_DO01MCPU-if00-port0", // Inertial Labs KERNEL IMU (FTDI FT230X)
		// "--device=/dev/esp32-chassis", // ESP32-S3 micro-ROS chassis controller (host udev symlink)
		// uncomment to use Nvidia GPU with Linux, https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html
		// "--runtime=nvidia"
		// uncomment to use Nvidia GPU with Windows WSL2
		// "--volume=/usr/lib/wsl:/usr/lib/wsl",
		// "--device=/dev/dxg",
		// "--device=/dev/dri/card0",
		// "--device=/dev/dri/renderD128",
		// "--gpus=all"
	],
	"containerEnv": {
		// Use Cyclone DDS to match the robot container. See deploy/docker-compose.yaml.
		"RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
		"DISPLAY": "${localEnv:DISPLAY}", // Needed for GUI try ":0" for windows
		"XAUTHORITY": "${localEnv:XAUTHORITY}",
		// For Wayland
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
		// "QT_QPA_PLATFORM": "wayland", // uncomment to force Wayland
		// For audio
		"PULSE_SERVER": "${localEnv:PULSE_SERVER}",
		"LIBGL_ALWAYS_SOFTWARE": "1" // Needed for software rendering of opengl
	},
	"remoteUser": "ros",
	// Set *default* container specific settings.json values on container create.
	"customizations": {
		"vscode": {
			"extensions": [
				"althack.ament-task-provider",
				"betwo.b2-catkin-tools",
				"DotJoshJohnson.xml",
				"ms-azuretools.vscode-docker",
				"ms-python.autopep8",
				"ms-python.python",
				"ms-vscode.cpptools",
				"Ranch-Hand-Robotics.rde-pack",
				"redhat.vscode-yaml",
				"streetsidesoftware.code-spell-checker",
				"twxs.cmake",
				"yzhang.markdown-all-in-one",
				"zachflower.uncrustify"
			]
		}
	}
}
