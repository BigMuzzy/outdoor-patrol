// Dev container variant for on-device development on Orange Pi 5 (RK3588, arm64).
// Reuses the workstation Dockerfile but strips X11/Wayland/NVIDIA bits and adds
// hardware passthrough for typical robot sensors.
//
// Usage: VS Code → "Dev Containers: Reopen in Container" → pick "orangepi".
{
	"name": "outdoor-patrol (Orange Pi 5)",
	"dockerFile": "../Dockerfile",
	"context": "..",
	"build": {
		"args": {
			"ROS_DISTRO": "jazzy",
			// "ros-base" would be lighter, but keep parity with workstation by default.
			"ROS_VARIANT": "full"
		},
		"options": ["--pull", "--platform=linux/arm64"]
	},
	"runArgs": [
		"--platform=linux/arm64",
		"--network=host",
		"--ipc=host",
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined",

		// --- Hardware passthrough (uncomment what your robot actually has) ---
		// Serial / USB-serial (GPS, IMU, microcontrollers)
		// "--device=/dev/ttyUSB0",
		// "--device=/dev/ttyACM0",
		// I2C / SPI / GPIO (RK3588 exposes these)
		// "--device=/dev/i2c-1",
		// "--device=/dev/spidev0.0",
		// "--device=/dev/gpiochip0",
		// Cameras (UVC / MIPI-CSI via V4L2)
		// "--device=/dev/video0",
		// CAN bus (if using a CAN HAT)
		// Requires `ip link set can0 up` on the host first.
		// Mali GPU / RKNN NPU (optional)
		// "--device=/dev/dri",
		// "--device=/dev/dri/renderD128",
		// "--device=/dev/rknpu",

		// Give the container user access to typical hw groups on the host.
		"--group-add=dialout",
		"--group-add=plugdev",
		"--group-add=video"
		// "--group-add=i2c",
		// "--group-add=gpio"
	],
	"containerEnv": {
		// Headless: no DISPLAY/WAYLAND_DISPLAY/XAUTHORITY here.
		// ROS 2 / DDS tuning lives here if needed.
		// "ROS_DOMAIN_ID": "42",
		// "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp"
	},
	"remoteUser": "ros",
	"customizations": {
		"vscode": {
			"extensions": [
				"althack.ament-task-provider",
				"DotJoshJohnson.xml",
				"ms-python.autopep8",
				"ms-python.python",
				"ms-vscode.cpptools",
				"Ranch-Hand-Robotics.rde-pack",
				"redhat.vscode-yaml",
				"twxs.cmake",
				"zachflower.uncrustify"
			]
		}
	}
}
